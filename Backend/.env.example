# Copie para .env localmente; não coloque valores reais neste arquivo versionado.
DB_PORT=5433
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/fooddelivery
DATABASE_USERNAME=fooddelivery_app
DATABASE_PASSWORD=
PGADMIN_DB_USER=fooddelivery_admin
PGADMIN_DB_PASSWORD=
JWT_SECRET=
APP_ADMIN_EMAIL=admin@fooddelivery.local
APP_ADMIN_PASSWORD=

# Recuperação por e-mail (SMTP). Sem essas credenciais o pedido continua neutro,
# mas nenhum e-mail será enviado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
RECOVERY_EMAIL_FROM=no-reply@fooddelivery.local

# WhatsApp Cloud API é opcional. O template precisa estar aprovado na Meta e
# conter uma variável {{1}} no corpo para receber o código de seis dígitos.
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=fooddelivery_password_recovery
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Mercado Pago Marketplace / Checkout Pro
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://127.0.0.1:8080/api/v1/payments/mercadopago/callback
MP_TOKEN_ENCRYPTION_KEY=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_BASE_URL=
MP_SANDBOX=true
FRONTEND_URL=http://127.0.0.1:5173

# Arquivos de capa enviados pelo vendedor e aprovados pelo administrador
STORE_ASSETS_DIR=./data/store-assets

# Armazenamento opcional persistente; nunca preencher chaves reais neste exemplo.
STORE_ASSETS_PROVIDER=local
SUPABASE_PROJECT_URL=
SUPABASE_STORAGE_BUCKET=store-covers
# Preferir chave secreta atual (sb_secret_...); apenas no servidor.
SUPABASE_SECRET_KEY=
# Compatibilidade com a chave JWT legada; desnecessária se SECRET_KEY foi definida.
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL gerenciado: schema privado criado previamente, sem exposição na Data API.
DATABASE_SCHEMA=public
DATABASE_POOL_SIZE=5
