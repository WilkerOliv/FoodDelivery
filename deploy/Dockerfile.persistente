FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY Backend/pom.xml ./
COPY Backend/src ./src
RUN mvn --batch-mode -DskipTests package

FROM caddy:2.10.2 AS proxy
FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 fooddelivery \
    && useradd --uid 10001 --gid 10001 --no-create-home fooddelivery
WORKDIR /app
# A imagem oficial do Caddy marca o binário com cap_net_bind_service. O Render executa o
# contêiner sem essa capability e o execve falha com EPERM. O proxy escuta na porta 10000
# (> 1024), então a capability é desnecessária: recriar o arquivo descarta o xattr.
COPY --from=proxy /usr/bin/caddy /usr/local/bin/caddy.orig
RUN cat /usr/local/bin/caddy.orig > /usr/local/bin/caddy \
    && chmod 0755 /usr/local/bin/caddy \
    && rm /usr/local/bin/caddy.orig
COPY --from=build /build/target/food-delivery-api-*.jar /app/api.jar
COPY Frontend/index.html Frontend/styles.css Frontend/theme.css Frontend/favicon.ico Frontend/favicon.svg /app/web/
COPY Frontend/src /app/web/src
COPY deploy/Caddyfile.persistente /app/Caddyfile
COPY deploy/persistente.py /app/launcher.py
USER 10001:10001
ENV PORT=10000
EXPOSE 10000
CMD ["python3", "-u", "/app/launcher.py"]
